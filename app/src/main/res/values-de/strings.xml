    <string name="welcome_title">Willkommen bei Smart Garage</string>
    <string name="welcome_body">Die Begleit-App für deinen selbst gehosteten Smart-Garage-Server.</string>
    <string name="welcome_feature_server_title">Dein Server, deine Daten</string>
    <string name="welcome_feature_server_body">Die App spricht nur mit deinem Smart Garage. Kein Cloud-Konto, nichts geht an Google.</string>
    <string name="welcome_feature_offline_title">Funktioniert ohne Empfang</string>
    <string name="welcome_feature_offline_body">Nachschlagen und Tanken erfassen geht auch offline; synchronisiert wird, sobald du wieder online bist.</string>
    <string name="welcome_feature_private_title">Bleibt privat</string>
    <string name="welcome_feature_private_body">Funktioniert mit Cloudflare Access; Anmeldetokens liegen in der Sicherheitshardware des Telefons.</string>
    <string name="welcome_get_started">Los geht\'s</string>

    <string name="server_title">Mit deinem Server verbinden</string>
    <string name="server_intro">Gib die Adresse ein, unter der du Smart Garage im Browser öffnest, und teste die Verbindung.</string>
    <string name="server_url_label">Serveradresse</string>
    <string name="server_url_hint">Deine Tunnel-Adresse oder eine LAN-Adresse wie http://192.168.1.10:3000</string>
    <string name="server_url_error_empty">Gib die Serveradresse ein.</string>
    <string name="server_url_error_malformed">Das sieht nicht nach einer Webadresse aus.</string>
    <string name="server_url_error_scheme">Verwende eine Adresse, die mit https:// oder http:// beginnt.</string>
    <string name="server_url_error_cleartext">Unverschlüsseltes http ist nur im Heimnetz erlaubt. Verwende https:// für diese Adresse.</string>
    <string name="server_name_label">Name (optional)</string>
    <string name="server_name_hint">Wird beim Wechseln zwischen Servern angezeigt</string>
    <string name="server_cf_title">Cloudflare Access</string>
    <string name="server_cf_body">Einschalten, wenn diese Adresse vor Smart Garage eine Cloudflare-Anmeldung verlangt.</string>
    <string name="server_cf_client_id">Client-ID</string>
    <string name="server_cf_client_secret">Client-Secret</string>
    <string name="server_cf_hint">Unter Zero Trust → Access → Service credentials. Die App sendet es bei jeder Anfrage mit.</string>
    <string name="server_cf_missing">Gib Client-ID und Client-Secret ein.</string>
    <string name="server_test">Testen</string>
    <string name="server_ok_title">Mit Smart Garage verbunden</string>
    <string name="server_ok_version">Serverversion %1$s.</string>
    <string name="server_ok_cloudflare">Cloudflare hat die App durchgelassen.</string>

    <string name="problem_dns_title">Server nicht gefunden</string>
    <string name="problem_dns_body">Diese Adresse existiert nicht. Prüfe sie auf Tippfehler, oder ob sie nur im Heimnetz funktioniert.</string>
    <string name="problem_refused_title">Server nicht erreichbar</string>
    <string name="problem_refused_body">Unter dieser Adresse und diesem Port antwortet nichts. Prüfe, ob Smart Garage läuft.</string>
    <string name="problem_network_other_body">Die Verbindung ist fehlgeschlagen, bevor der Server antwortete. Prüfe deine Internetverbindung.</string>
    <string name="problem_timeout_title">Zeitüberschreitung</string>
    <string name="problem_timeout_body">Der Server hat nicht rechtzeitig geantwortet. Prüfe deine Verbindung, oder ob die Adresse nur zu Hause funktioniert.</string>
    <string name="problem_tls_title">Sichere Verbindung fehlgeschlagen</string>
    <string name="problem_tls_body">Dem HTTPS-Zertifikat des Servers wird nicht vertraut, oder der Server spricht auf diesem Port kein HTTPS.</string>
    <string name="problem_access_title">Cloudflare Access hat die App blockiert</string>
    <string name="problem_access_body_token">Cloudflare hat statt Smart Garage geantwortet. Prüfe Client-ID und Secret, und ob die Access-Anwendung eine „Service Auth“-Regel mit diesem Service-Token hat.</string>
    <string name="problem_access_body_missing">Diese Adresse ist durch Cloudflare Access geschützt. Schalte unten Cloudflare Access ein und gib dein Service-Token ein.</string>
    <string name="problem_challenge_title">Cloudflare hat die App geprüft</string>
    <string name="problem_challenge_body">Eine Bot- oder Firewall-Regel zeigt eine Prüfseite, statt die App durchzulassen. Lege für diesen Hostnamen eine Regel an, die Prüfungen überspringt.</string>
    <string name="problem_gateway_title">Smart Garage hinter dem Tunnel nicht erreichbar</string>
    <string name="problem_gateway_body">Tunnel oder Proxy haben geantwortet, aber Smart Garage nicht erreicht (HTTP %1$d). Prüfe, ob Container und cloudflared laufen.</string>
    <string name="problem_redirect_title">Der Server leitet weiter</string>
    <string name="problem_redirect_body">Diese Adresse leitet zu %1$s weiter. Gib stattdessen diese Adresse ein.</string>
    <string name="problem_redirect_body_unknown">Diese Adresse leitet woandershin weiter. Prüfe, ob es die richtige ist.</string>
    <string name="problem_not_sg_title">Das ist nicht Smart Garage</string>
    <string name="problem_not_sg_body">Es hat etwas geantwortet (HTTP %1$d), aber nicht die Smart-Garage-API. Prüfe die Adresse, und ob der Server eine Version mit Mobil-API nutzt.</string>
    <string name="problem_api_title">Server braucht ein Update</string>
    <string name="problem_api_body">Dieses Smart Garage hat nicht die Mobil-API, die die App braucht. Aktualisiere den Container auf das Image des Forks.</string>
    <string name="problem_db_title">Smart Garage erreicht seine Datenbank nicht</string>
    <string name="problem_db_body">Der Server läuft, aber seine Datenbank ist nicht verfügbar. Prüfe die Container-Logs.</string>
    <string name="problem_unexpected_title">Etwas ist schiefgelaufen</string>
    <string name="problem_unexpected_body">Der Server hat mit HTTP %1$d geantwortet.</string>

