    <string name="server_cf_client_secret">Client-Secret</string>
    <string name="server_cf_hint">Unter Zero Trust → Access → Service credentials. Die App sendet es bei jeder Anfrage mit.</string>
    <string name="server_cf_missing">Gib Client-ID und Client-Secret ein.</string>
    <string name="server_test">Testen</string>
