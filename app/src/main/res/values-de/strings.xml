    <string name="welcome_title">Willkommen bei Smart Garage</string>
    <string name="welcome_body">Die Begleit-App für deinen selbst gehosteten Smart-Garage-Server.</string>
    <string name="welcome_feature_server_title">Dein Server, deine Daten</string>
    <string name="welcome_feature_server_body">Die App spricht nur mit deinem Smart Garage. Kein Cloud-Konto, nichts geht an Google.</string>
    <string name="welcome_feature_offline_title">Funktioniert ohne Empfang</string>
    <string name="welcome_feature_offline_body">Nachschlagen und Tanken erfassen geht auch offline; synchronisiert wird, sobald du wieder online bist.</string>
    <string name="welcome_feature_private_title">Bleibt privat</string>
    <string name="welcome_feature_private_body">Funktioniert mit Cloudflare Access; Anmeldetokens liegen in der Sicherheitshardware des Telefons.</string>
    <string name="welcome_get_started">Los geht\'s</string>

    <string name="server_title">Mit deinem Server verbinden</string>
    <string name="server_intro">Gib die Adresse ein, unter der du Smart Garage im Browser öffnest, und teste die Verbindung.</string>
