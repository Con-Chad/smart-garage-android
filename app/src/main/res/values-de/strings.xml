    <string name="server_url_error_malformed">Das sieht nicht nach einer Webadresse aus.</string>
    <string name="server_url_error_scheme">Verwende eine Adresse, die mit https:// oder http:// beginnt.</string>
    <string name="server_url_error_cleartext">Unverschlüsseltes http ist nur im Heimnetz erlaubt. Verwende https:// für diese Adresse.</string>
