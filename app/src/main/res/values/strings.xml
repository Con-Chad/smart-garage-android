    <!-- Welcome -->
    <string name="welcome_title">Welcome to Smart Garage</string>
    <string name="welcome_body">The companion app for your self-hosted Smart Garage server.</string>
    <string name="welcome_feature_server_title">Your server, your data</string>
    <string name="welcome_feature_server_body">The app talks only to your Smart Garage. There\'s no cloud account and nothing goes to Google.</string>
    <string name="welcome_feature_offline_title">Works without signal</string>
    <string name="welcome_feature_offline_body">Look things up and log a fill-up offline; it syncs once you\'re back online.</string>
    <string name="welcome_feature_private_title">Stays private</string>
    <string name="welcome_feature_private_body">Works through Cloudflare Access, with sign-in tokens kept in the phone\'s secure hardware.</string>
    <string name="welcome_get_started">Get started</string>

    <!-- Server step -->
    <string name="server_title">Connect to your server</string>
    <string name="server_intro">Enter the address you use for Smart Garage in your browser, then test the connection.</string>
    <string name="server_url_label">Server address</string>
    <string name="server_url_hint">Your tunnel address, or a LAN address like http://192.168.1.10:3000</string>
    <string name="server_url_error_empty">Enter the server address.</string>
    <string name="server_url_error_malformed">That doesn\'t look like a web address.</string>
    <string name="server_url_error_scheme">Use an address starting with https:// or http://.</string>
    <string name="server_url_error_cleartext">Plain http is only allowed on your home network. Use https:// for this address.</string>
    <string name="server_name_label">Name (optional)</string>
    <string name="server_name_hint">Shown when you switch between servers</string>
    <string name="server_cf_title">Cloudflare Access</string>
    <string name="server_cf_body">Turn on if this address asks you to sign in with Cloudflare before Smart Garage.</string>
    <string name="server_cf_client_id">Client ID</string>
    <string name="server_cf_client_secret">Client secret</string>
    <string name="server_cf_hint">From Zero Trust → Access → Service credentials. The app sends it with every request.</string>
    <string name="server_cf_missing">Enter both the client ID and the client secret.</string>
    <string name="server_test">Test</string>
    <string name="server_ok_title">Connected to Smart Garage</string>
    <string name="server_ok_version">Server version %1$s.</string>
    <string name="server_ok_cloudflare">Cloudflare let the app through.</string>

    <!-- Connection problems -->
    <string name="problem_dns_title">Server not found</string>
    <string name="problem_dns_body">This address doesn\'t exist. Check for typos, or whether it only works on your home network.</string>
    <string name="problem_refused_title">Server unreachable</string>
    <string name="problem_refused_body">Nothing is answering at this address and port. Check that Smart Garage is running.</string>
    <string name="problem_network_other_body">The connection failed before the server answered. Check your internet connection.</string>
    <string name="problem_timeout_title">Connection timed out</string>
    <string name="problem_timeout_body">The server didn\'t answer in time. Check your connection, or whether this address only works at home.</string>
    <string name="problem_tls_title">Secure connection failed</string>
    <string name="problem_tls_body">The server\'s HTTPS certificate isn\'t trusted, or the server doesn\'t use HTTPS on this port.</string>
    <string name="problem_access_title">Cloudflare Access blocked the app</string>
    <string name="problem_access_body_token">Cloudflare answered instead of Smart Garage. Check the client ID and secret, and that the Access application has a Service Auth policy that includes this service token.</string>
    <string name="problem_access_body_missing">This address is protected by Cloudflare Access. Turn on Cloudflare Access below and enter your service token.</string>
    <string name="problem_challenge_title">Cloudflare challenged the app</string>
    <string name="problem_challenge_body">A bot-protection or firewall rule shows a challenge page instead of letting the app through. Add a rule that skips challenges for this hostname.</string>
    <string name="problem_gateway_title">Smart Garage is down behind the tunnel</string>
    <string name="problem_gateway_body">The tunnel or proxy answered but couldn\'t reach Smart Garage (HTTP %1$d). Check that the container and cloudflared are running.</string>
    <string name="problem_redirect_title">The server redirects elsewhere</string>
    <string name="problem_redirect_body">This address forwards to %1$s. Enter that address instead.</string>
    <string name="problem_redirect_body_unknown">This address forwards somewhere else. Check that it\'s the right one.</string>
    <string name="problem_not_sg_title">That\'s not Smart Garage</string>
    <string name="problem_not_sg_body">Something answered (HTTP %1$d), but it isn\'t the Smart Garage API. Check the address, and that the server runs a version with the mobile API.</string>
    <string name="problem_api_title">Server needs an update</string>
    <string name="problem_api_body">This Smart Garage doesn\'t have the mobile API this app needs. Update the container to the companion fork\'s image.</string>
    <string name="problem_db_title">Smart Garage can\'t reach its database</string>
    <string name="problem_db_body">The server is running but its database isn\'t available. Check the container logs.</string>
    <string name="problem_unexpected_title">Something went wrong</string>
    <string name="problem_unexpected_body">The server answered with HTTP %1$d.</string>

