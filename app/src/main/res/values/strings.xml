    <string name="coming_soon_title">Coming soon</string>
    <string name="section_vehicles_desc">Your cars with photos, specs, custom fields and a quick odometer update.</string>
    <string name="section_maintenance_desc">Schedules sorted by what\'s due, and logging a service with prefilled parts.</string>
    <string name="section_fuel_desc">A one-screen fill-up built for the gas station, plus your log and MPG charts.</string>
    <string name="section_reminders_desc">Upcoming services, inspections and insurance</string>
    <string name="section_history_desc">Everything that happened to each car, in one timeline</string>
    <string name="section_odometer_desc">Mileage readings and charts</string>
    <string name="section_expenses_desc">Costs by month and category</string>
    <string name="section_documents_desc">Receipts, PDFs and photos</string>
    <string name="section_notes_desc">Markdown notes with tags</string>
    <string name="section_wishlist_desc">Parts and upgrades you\'re planning</string>

